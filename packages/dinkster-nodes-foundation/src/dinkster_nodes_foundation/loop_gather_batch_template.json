      "links": {}, "nets": {}, "reroutes": {},
      "boundary": {
        "inputs": [{ "id": "size", "binds": { "kind": "port", "node": "image", "port": "width" } }],
        "outputs": [{ "id": "generatedImage", "binds": { "kind": "port", "node": "image", "port": "image" } }]
      },
      "nextOrdinal": 1
    }
  },
  "view": { "graphs": { "root": { "nodes": { "map": { "position": { "x": 120, "y": 120 } }, "batch": { "position": { "x": 440, "y": 120 } } } }, "imageBody": { "nodes": { "image": { "position": { "x": 140, "y": 120 } } } } } },
  "meta": { "title": "Loop: Gather Image Batch" }
}
