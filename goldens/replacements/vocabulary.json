            "types": [
              "core.float"
            ]
          },
          "required": false
        },
        {
          "role": "input",
          "id": "mode",
          "type": {
            "kind": "concrete",
            "types": [
              "core.string"
            ]
          },
          "required": false
        },
        {
          "role": "input",
          "id": "label",
          "type": {
            "kind": "concrete",
            "types": [
              "core.string"
            ]
          },
          "required": false
        },
        {
          "role": "input",
          "id": "enabled",
          "type": {
            "kind": "concrete",
            "types": [
              "core.boolean"
            ]
          },
          "required": false
        },
        {
          "role": "input",
          "id": "frames",
          "type": {
            "kind": "list",
            "element": {
              "kind": "concrete",
              "types": [
                "core.string"
              ]
            }
          },
          "required": false
        },
        {
          "role": "output",
          "id": "result",
          "type": {
