{
  "format_version": 1,
  "about": "Shared cases for the replacement language's spread input family mapping: one stored list becomes a group's members in order. Dinkster's graph migration and Dinkster-Frontend's replacement planner both check every case, so the two cannot drift. 'values' lists every stored value under the target group, defaults included.",
  "schemas": [
    {
      "schemaVersion": 2,
      "nodeType": "test.palette",
      "version": 1,
      "displayName": "",
      "category": "",
      "description": "",
      "idempotent": true,
      "interface": [],
      "body": [
        {
          "kind": "group",
          "id": "colors",
          "value": {
            "kind": "input",
            "id": "color",
            "type": {
              "kind": "concrete",
              "types": [
                "COLOR"
              ]
            },
            "required": true,
            "default": "#000000"
          },
          "keys": {
            "numbered": {
              "prefix": "color",
              "start": 0,
              "pad": 0
            }
          },
          "grows": "link",
          "maxMembers": 16,
          "reorderable": true
        }
      ],
      "replacements": [
        {
          "from": "test.palette_v1",
          "cases": [
            {
              "to": "test.palette",
              "inputFamilies": {
                "colors": {
                  "kind": "spread",
                  "input": "colors"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "schemaVersion": 2,
      "nodeType": "test.swatches",
      "version": 1,
      "displayName": "",
      "category": "",
      "description": "",
      "idempotent": true,
      "interface": [],
      "body": [
        {
          "kind": "group",
          "id": "swatches",
          "member": [
            {
              "kind": "input",
              "id": "color",
              "type": {
                "kind": "concrete",
                "types": [
                  "COLOR"
                ]
              },
              "required": true,
              "default": "#000000"
            },
            {
              "kind": "input",
              "id": "label",
              "type": {
                "kind": "concrete",
                "types": [
                  "STRING"
                ]
              },
              "required": true,
              "default": ""
            }
          ],
          "keys": {
            "numbered": {
              "prefix": "swatch",
              "start": 1,
              "pad": 0
            }
          },
          "grows": "link",
          "minMembers": 2
        }
      ],
      "replacements": [
        {
          "from": "test.swatches_v1",
          "cases": [
            {
              "to": "test.swatches",
              "inputFamilies": {
                "swatches": {
                  "kind": "spread",
                  "input": "colors",
                  "member": "color"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "cases": [
    {
      "name": "three colors",
      "type": "test.palette_v1",
      "values": {
        "colors": [
          "#ff0000",
          "#00ff00",
          "#0000ff"
        ]
      },
      "expect": {
        "type": "test.palette",
        "members": {
          "colors": [
            "color0",
            "color1",
            "color2"
          ]
        },
        "values": {
          "colors.color0": "#ff0000",
          "colors.color1": "#00ff00",
          "colors.color2": "#0000ff"
        },
        "warnings": []
      }
    },
    {
      "name": "an empty list",
      "type": "test.palette_v1",
      "values": {
        "colors": []
      },
      "expect": {
        "type": "test.palette",
        "members": {
          "colors": []
        },
        "values": {},
        "warnings": []
      }
    },
    {
      "name": "no stored list",
      "type": "test.palette_v1",
      "values": {},
