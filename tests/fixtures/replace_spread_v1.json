          "colors.color2": "#030303",
          "colors.color3": "#040404",
          "colors.color4": "#050505",
          "colors.color5": "#060606",
          "colors.color6": "#070707",
          "colors.color7": "#080808",
          "colors.color8": "#090909",
          "colors.color9": "#0a0a0a",
          "colors.color10": "#0b0b0b",
          "colors.color11": "#0c0c0c",
          "colors.color12": "#0d0d0d",
          "colors.color13": "#0e0e0e",
          "colors.color14": "#0f0f0f",
          "colors.color15": "#101010"
        },
        "warnings": [
          {
            "code": "replace.spread.dropped",
            "message": "replace: kept the first 16 of 20 items of 'colors'; dropped #111111, #121212, #131313, #141414"
          }
        ]
      }
    },
    {
      "name": "a stored value that is not a list",
      "type": "test.palette_v1",
      "values": {
        "colors": "#ff0000"
      },
      "expect": {
        "error": {
          "code": "replace.spread.notList",
          "message": "replace: stored value of 'colors' is not a list; cannot spread"
        }
      }
    },
    {
      "name": "three colors into members of records",
      "type": "test.swatches_v1",
      "values": {
